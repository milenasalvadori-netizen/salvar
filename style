:root{
      --cor-primaria: #183C63;
      --cor-secundaria: #7ca8d6;
      --cor-fundo:  #e9ecf0;
      --cor-texto: #021122;
      --cor-contraste: #cce0f5;
      --cor-botao: #bec4ca;
}

.tema-escuro {
      --cor-primaria: #183C63;
      --cor-secundaria: #7ca8d6;
      --cor-fundo:  #e9ecf0;
      --cor-texto: #021122;
      --cor-contraste: #cce0f5;
      --cor-botao: #bec4ca;
}
}

body {
        max-width: 100vw;
}

header {
background-color: var(--cor-primaria);
color: var(--cor-contraste);
text-align: center;
margin: 0 auto;
padding: 16px;
      }

main{
        background-color: var(--cor-fundo);
        color: var(--cor-primaria);
        margin: 0 auto;
        padding: 16px

        display: flex;
        flex-wrap: wrap;
 }

 article{
    display: flex;

    border: 1px solid #183C63

    margin: 16px;
    gap: 16px;
    padding: 16px;

    flex: 1 1 25%;
 }

        img{
width: 80px;
height: 80px;
        }
