:root{
      --cor-primaria: #183C63;
      --cor-secundaria: #7ca8d6;
      --cor-fundo:  #e9ecf0;
      --cor-texto: #021122;
      --cor-contraste: #cce0f5;
      --cor-botao: #bec4ca;

      --fonte-texto: 'Times New Roman'
}

* {
      transition: background-color 0.3s ease;
}

.tema-escuro {
      --cor-primaria: #183C63;
      --cor-secundaria: #7ca8d6;
      --cor-fundo:  #e9ecf0;
      --cor-texto: #021122;
      --cor-contraste: #cce0f5;
      --cor-botao: #bec4ca;
}

.tema-escuro a {
      color: var(--cor-secundaria);
}

.tema-escuro p {
      color: var(--cor-texto)
}

.tema-escuro header p {
      color: var(--cor-contraste);

}
 
.tema-escuro article {
      background-color: #4d320f;
}

.tema-escuro h2 {
      color: var(--cor-primaria);
}

.tema-escuro .artigo-autor {
      color: var(--cor-secundaria);
}

.tema-escuro .btn-tema-escuro {
      background-color: var(--cor-secundaria);
}

body {            
        max-width: 100vw;
        font-family: var(--fonte-texto)       
}

header {
background-color: var(--cor-primaria);
color: var(--cor-contraste);
text-align: center;
margin: 0 auto;
padding: 16px;
}

main{
        background-color: var(--cor-fundo);
        color: var(--cor-primaria);
        margin: 0 auto;
        padding: 16px
        display: flex;
        flex-wrap: wrap;
}

 article{
    display: flex;
    box-shadow: 0 2px 6px;

    margin: 16px;
    gap: 16px;
    padding: 16px;

    flex: 1 1 25%;
}

img {
      width: 80px;
      height: 80px;
}

.artigo-autor {
      font-weight: bold;
}

.btn-tema-escuro {
      position: fixed;
      bottom: 16px;
      right: 16px;
      font-size: 32px;
      padding: 12px;
      background-color: var(--cor-primaria);
      border-radius: 50%;
}

